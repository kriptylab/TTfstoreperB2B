---
import TopBar from './TopBar.astro';
---

<TopBar />

<header class="sticky top-0 z-40 bg-white border-b border-steel/60 shadow-xs backdrop-blur-md bg-white/95">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20 gap-4">
      
      <!-- TTF STORE Official Logo -->
      <a href="/" class="shrink-0 flex items-center gap-2.5 group" aria-label="TTF STORE Home">
        <img
          src="/immagini/ttf-logo.png"
          alt="TTF STORE Logo"
          class="h-9 md:h-11 w-auto object-contain transition-transform duration-200 group-hover:scale-105"
          width="120"
          height="40"
        />
        <div class="flex flex-col">
          <span class="font-extrabold text-xl md:text-2xl tracking-tight text-ink flex items-center gap-1">
            STORE <span class="text-xs px-2 py-0.5 rounded-md bg-teal/15 text-teal font-mono uppercase tracking-wider font-bold">Ho.Re.Ca.</span>
          </span>
          <span class="text-[10px] text-ink-muted hidden sm:block">Attrezzature Professionali & Ristorazione</span>
        </div>
      </a>

      <!-- Quick Search Bar Styled TTF STORE -->
      <div class="flex-1 max-w-xl hidden md:block">
        <form action="/products" method="GET" class="relative flex items-center">
          <input
            type="text"
            name="q"
            id="header-search-input"
            placeholder="Cerca tra 3.050 articoli, codici o brand (es. Fimar, Forcold, Easyline)..."
            class="w-full h-11 pl-4 pr-12 rounded-xl bg-paper border border-steel text-sm text-ink outline-none transition-all duration-150 focus:border-teal focus:ring-2 focus:ring-teal/20"
            aria-label="Cerca prodotti TTF STORE"
          />
          <button
            type="submit"
            class="absolute right-1 top-1/2 -translate-y-1/2 h-9 px-3.5 rounded-lg text-white font-bold text-xs flex items-center justify-center transition-all duration-150 hover:opacity-90"
            style="background-color: #00B2A9;"
            title="Cerca prodotti"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </button>
        </form>
      </div>

      <!-- Nav links -->
      <nav class="hidden lg:flex items-center space-x-6 text-sm font-semibold text-ink">
        <a href="/" class="hover:text-teal transition-colors duration-150">Home</a>
        <a href="/products" class="text-teal font-bold flex items-center gap-1.5">
          <span>Catalogo Ho.Re.Ca.</span>
          <span class="badge-sconto text-[10px]">-40%</span>
        </a>
        <a href="/products?brand=FORCOLD" class="hover:text-teal transition-colors duration-150">Forcold</a>
        <a href="/products?brand=FIMAR" class="hover:text-teal transition-colors duration-150">Fimar</a>
        <a href="/products?brand=EASYLINE" class="hover:text-teal transition-colors duration-150">Easyline</a>
      </nav>

      <!-- Right Action CTA -->
      <div class="flex items-center gap-2 sm:gap-3">
        <a 
          href="/preventivo"
          class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-ink hover:bg-teal text-white font-bold text-xs transition-colors duration-200"
        >
          <span>Richiedi Preventivo</span>
        </a>
        <a
          href="https://wa.me/393397234452?text=Salve%20TTF%20STORE,%20desidero%20maggiori%20informazioni%20su%20un%20preventivo%20B2B%20Ho.Re.Ca."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-3.5 py-2 text-xs font-bold text-white bg-emerald-500 hover:bg-emerald-600 rounded-xl shadow-xs transition-colors duration-200 gap-1.5"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          Preventivo WhatsApp
        </a>
      </div>
    </div>
  </div>
</header>
