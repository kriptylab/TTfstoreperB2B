---
const currentYear = new Date().getFullYear();
---

<!-- Trust Strip Boxes (4 info-card TTF STORE) -->
<section class="bg-steel/30 border-y border-steel/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">

      <div class="flex items-start gap-4 p-4 rounded-xl bg-white border border-steel/50 shadow-xs hover:shadow-md transition-all duration-200">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 bg-teal-light">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 8"/>
            <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-ink">Corriere Espresso 24/48h</h3>
          <p class="text-xs text-ink-muted mt-1 leading-relaxed">Spedizione rapida e tracciata in tutta Italia e San Marino.</p>
        </div>
      </div>

      <div class="flex items-start gap-4 p-4 rounded-xl bg-white border border-steel/50 shadow-xs hover:shadow-md transition-all duration-200">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 bg-verify-light">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-verify" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <polyline points="9 12 11 14 15 10"/>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-ink">Sede San Marino</h3>
          <p class="text-xs text-ink-muted mt-1 leading-relaxed">Magazzino locale e supporto diretto sul territorio RSM.</p>
        </div>
      </div>

      <div class="flex items-start gap-4 p-4 rounded-xl bg-white border border-steel/50 shadow-xs hover:shadow-md transition-all duration-200">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 bg-teal-light">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-ink">Pagamenti 100% Sicuri</h3>
          <p class="text-xs text-ink-muted mt-1 leading-relaxed">Carte, Bonifico Bancario, PayPal e Scalapay a rate.</p>
        </div>
      </div>

      <div class="flex items-start gap-4 p-4 rounded-xl bg-white border border-steel/50 shadow-xs hover:shadow-md transition-all duration-200">
        <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 bg-outlet-light">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-outlet" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-ink">Sconti B2B fino al 40%</h3>
          <p class="text-xs text-ink-muted mt-1 leading-relaxed">-30% dal listino ufficiale con extra 10% applicato a carrello.</p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Main Footer TTF STORE -->
<footer class="bg-ink text-white" itemscope itemtype="https://schema.org/Organization">
  <meta itemprop="name" content="TTF STORE" />
  <meta itemprop="legalName" content="TTF GROUP S.R.L." />
  <meta itemprop="url" content="https://www.ttfstore.com" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">

      <!-- Brand col -->
      <div class="col-span-1 lg:col-span-2">
        <div class="flex items-center gap-2.5 mb-4">
          <img src="/immagini/ttf-logo.png" alt="TTF STORE" class="h-9 w-auto object-contain" width="100" height="32" loading="lazy" decoding="async" />
          <span class="text-xl font-black tracking-tight text-white">STORE</span>
          <span class="text-xs px-2 py-0.5 rounded bg-teal text-white font-mono font-bold">HO.RE.CA.</span>
        </div>
        <p class="text-xs text-gray-400 leading-relaxed mb-4 max-w-sm">
          Piattaforma e-commerce B2B e retail specializzata in grandi forniture e attrezzature per la ristorazione professionale, bar, laboratori gastronomici e refrigerazione commerciale.
        </p>

        <!-- Dati societari esatti da TTF STORE -->
        <div class="font-mono text-[11px] text-gray-400 space-y-1 border-t border-gray-800 pt-3"
          itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
          <p class="font-bold text-gray-200 text-xs" itemprop="name">TTF GROUP S.R.L.</p>
          <p itemprop="streetAddress">Via Consiglio dei Sessanta 153</p>
          <p><span itemprop="postalCode">47891</span> <span itemprop="addressLocality">Dogana</span> (<span itemprop="addressRegion">RSM</span>)</p>
          <p itemprop="addressCountry" class="text-gray-400">Repubblica di San Marino</p>
          <p class="text-teal font-bold mt-1.5">COE: SM26425</p>
          <a href="mailto:postmaster@ttfstore.com" class="text-teal hover:underline block mt-1" itemprop="email">
            postmaster@ttfstore.com
          </a>
        </div>
      </div>

      <!-- Cataloghi Brand -->
      <div>
        <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-gray-300 mb-3">I Nostri Brand</h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/products?brand=FORCOLD" class="text-gray-400 hover:text-white transition-colors">FORCOLD Refrigerazione</a></li>
          <li><a href="/products?brand=FIMAR" class="text-gray-400 hover:text-white transition-colors">FIMAR Macchinari & Lavaggio</a></li>
          <li><a href="/products?brand=EASYLINE" class="text-gray-400 hover:text-white transition-colors">EASYLINE Cottura & Snack</a></li>
          <li><a href="/products" class="text-teal hover:underline font-bold mt-2 block">Tutti i 3.050 Prodotti →</a></li>
        </ul>
      </div>

      <!-- Assistenza & Contatti -->
      <div>
        <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-gray-300 mb-3">Assistenza Clienti</h3>
        <ul class="space-y-2 text-xs">
          <li><span class="text-gray-400">Email:</span> <a href="mailto:postmaster@ttfstore.com" class="text-teal hover:underline font-mono">postmaster@ttfstore.com</a></li>
          <li><span class="text-gray-400">Supporto Tecnico e Commerciale B2B</span></li>
          <li><span class="text-gray-400">Orari: Lun - Ven 09:00 - 18:00</span></li>
          <li><a href="/products" class="text-gray-400 hover:text-white transition-colors">Richiesta Preventivo Rapido</a></li>
        </ul>
      </div>

      <!-- Pagamenti e Garanzie -->
      <div>
        <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-gray-300 mb-3">Pagamenti Sicuri</h3>
        <div class="flex flex-wrap gap-1.5 mb-4">
          <span class="px-2 py-1 bg-white/10 border border-white/15 rounded text-[11px] font-mono font-bold text-gray-300">VISA</span>
          <span class="px-2 py-1 bg-white/10 border border-white/15 rounded text-[11px] font-mono font-bold text-gray-300">Mastercard</span>
          <span class="px-2 py-1 bg-white/10 border border-white/15 rounded text-[11px] font-mono font-bold text-gray-300">PayPal</span>
          <span class="px-2 py-1 bg-white/10 border border-white/15 rounded text-[11px] font-mono font-bold text-gray-300">Bonifico B2B</span>
          <span class="px-2 py-1 bg-white/10 border border-white/15 rounded text-[11px] font-mono font-bold text-gray-300">Scalapay</span>
        </div>
        <div class="text-[11px] text-gray-400 leading-tight">
          <span class="text-verify font-bold">✓ Garanzia Ufficiale Costruttore</span><br/>
          Tutti i prodotti vengono spediti con fattura e certificato di garanzia ufficiale.
        </div>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="border-t border-gray-800 mt-10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 font-mono text-[11px] text-gray-500">
      <p>
        © {currentYear} <strong class="text-gray-300">TTF STORE</strong> — TTF GROUP S.R.L. · COE SM26425 · Tutti i diritti riservati
      </p>
      <div class="flex items-center gap-4">
        <span class="flex items-center gap-1 text-teal">
          <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          SSL 256-BIT CRITTOGRAFATO
        </span>
        <span>ASTRO 7 · VERCEL EDGE</span>
        <span>RSM / IT</span>
      </div>
    </div>
  </div>
</footer>
